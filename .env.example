# Copy to ~/.env and fill in values (never commit ~/.env).
# Exchange prefixes stay separate so S3 layouts and --resume stay compatible.

# =============================================================================
# Binance Vision
# =============================================================================

# Generic fallback aliases are also accepted by all S3 mirrors:
# S3_URL, S3_ACCESS_KEY, S3_SECRET_KEY. Exchange-specific variables below take precedence.
# Hetzner Object Storage (or S3-compatible) — optional until S3 mirror
S3_BINANCE_VISION_BUCKET=binance
S3_BINANCE_VISION_ENDPOINT=https://fsn1.your-objectstorage.com
S3_BINANCE_VISION_REGION=fsn1
S3_BINANCE_VISION_ACCESS_KEY=
S3_BINANCE_VISION_SECRET_KEY=

# Legacy aliases (optional fallback)
# S3_BINANCE_BUCKET=binance
# S3_BINANCE_ENDPOINT=...
# S3_BINANCE_REGION=fsn1
# S3_BINANCE_ACCESS_KEY=
# S3_BINANCE_SECRET_KEY=

# Mirror tuning
BINANCE_VISION_PARALLEL=16

# ClickHouse (optional — analytics pipeline)
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_BINANCE_DATABASE=binance
# Product tables live in binance_vision (preferred).
CLICKHOUSE_VISION_DATABASE=binance_vision
CLICKHOUSE_INGEST_PARALLEL=4
# Hot tier for leftover binance.agg_trades path only — do not use for new work.
CLICKHOUSE_INGEST_SINCE_DAYS=1095
# Direct Vision → CH fetch (no S3); default ~18 months.
CLICKHOUSE_FETCH_SINCE_DAYS=548
CLICKHOUSE_FETCH_PARALLEL=12
KLINE_INTERVALS=1m,1h,1d

# Optional: local data root
# BINANCE_VISION_DATA_DIR=~/.data/binance-vision

# =============================================================================
# Kraken Historical
# =============================================================================

# Optional: Google Drive API key (fallback if public folder scrape fails)
# KRAKEN_GOOGLE_DRIVE_API_KEY=

# Hetzner Object Storage (or S3-compatible)
S3_KRAKEN_HISTORICAL_BUCKET=mercat-kraken
# Short alias accepted by the Kraken mirror: S3_KRAKEN_BUCKET.
S3_KRAKEN_HISTORICAL_ENDPOINT=https://fsn1.your-objectstorage.com
S3_KRAKEN_HISTORICAL_REGION=fsn1
S3_KRAKEN_HISTORICAL_ACCESS_KEY=
S3_KRAKEN_HISTORICAL_SECRET_KEY=
# Objects are written under historical/ inside the bucket.

# Mirror tuning (ZIP-internal CSV workers; keep low for big archives)
KRAKEN_HISTORICAL_PARALLEL=4

# Optional: local data root
# KRAKEN_HISTORICAL_DATA_DIR=~/.data/kraken-historical

# =============================================================================
# OKX Historical
# =============================================================================

# Hetzner Object Storage (or S3-compatible) — optional until S3 mirror
S3_OKX_HISTORICAL_BUCKET=mercat-okx
# Short alias accepted by the OKX mirror: S3_OKX_BUCKET.
S3_OKX_HISTORICAL_ENDPOINT=https://fsn1.your-objectstorage.com
S3_OKX_HISTORICAL_REGION=fsn1
S3_OKX_HISTORICAL_ACCESS_KEY=
S3_OKX_HISTORICAL_SECRET_KEY=
# Objects are written under historical/ inside the bucket.

# Mirror tuning
OKX_HISTORICAL_PARALLEL=16

# Optional: local data root
# OKX_HISTORICAL_DATA_DIR=~/.data/okx-historical

# =============================================================================
# Bybit Historical
# =============================================================================

# Hetzner Object Storage (or S3-compatible)
S3_BYBIT_HISTORICAL_BUCKET=mercat-bybit
# Short alias accepted by the Bybit mirror: S3_BYBIT_BUCKET.
S3_BYBIT_HISTORICAL_ENDPOINT=https://fsn1.your-objectstorage.com
S3_BYBIT_HISTORICAL_REGION=fsn1
S3_BYBIT_HISTORICAL_ACCESS_KEY=
S3_BYBIT_HISTORICAL_SECRET_KEY=
# Objects are written under:
#   historical/data/orderbook/spot/...              (legacy Spot orderbook)
#   historical/manifest/bybit/orderbook/manifest.jsonl
#   historical/data/trade/spot/daily/...
#   historical/manifest/bybit/trade/spot/daily/manifest.jsonl
#   historical/data/{orderbook|trade}/contract/daily/...
#   historical/manifest/bybit/{orderbook|trade}/contract/daily/manifest.jsonl

# Mirror tuning (used by scripts/bybit/sync-s3.sh)
BYBIT_HISTORICAL_PARALLEL=8
# BYBIT_MARKET=spot
# DATA_TYPES=orderbook,trade
# BYBIT_DATA_TYPE=orderbook
# ALL_SYMBOLS=1

# Optional: raw local portal download root for scripts/bybit/download-orderbook.py
# BYBIT_DATA_DIR=~/.data/bybit-historical

# =============================================================================
# Deribit Historical
# =============================================================================

# OAuth client_credentials — required for production sync (authenticated rate limits).
# Unauthenticated history.deribit.com calls use opaque per-IP limits; do not backfill
# without credentials on a host shared with live feeds.
DERIBIT_CLIENT_ID=
DERIBIT_CLIENT_SECRET=
# DERIBIT_HISTORY_URL=https://history.deribit.com/api/v2
# DERIBIT_AUTH_URL=https://www.deribit.com/api/v2

# Hetzner Object Storage (or S3-compatible)
S3_DERIBIT_HISTORICAL_BUCKET=mercat-deribit
# Short alias accepted by the Deribit mirror: S3_DERIBIT_BUCKET.
S3_DERIBIT_HISTORICAL_ENDPOINT=https://fsn1.your-objectstorage.com
S3_DERIBIT_HISTORICAL_REGION=fsn1
S3_DERIBIT_HISTORICAL_ACCESS_KEY=
S3_DERIBIT_HISTORICAL_SECRET_KEY=
# Objects are written under:
#   historical/data/trade/{currency}/{instrument}/{YYYY-MM-DD}.parquet.zstd
#   historical/manifest/deribit/trade/manifest.jsonl

# Mirror tuning (used by scripts/deribit/sync-s3.sh); keep low (2–4).
DERIBIT_HISTORICAL_PARALLEL=2
# CURRENCY=BTC,ETH
# INSTRUMENTS=BTC-PERPETUAL
# INCLUDE_EXPIRED=1

